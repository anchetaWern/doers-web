---
// Phase 1: preserve areas of work without republishing unverified historic totals.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Photo from '../components/Photo.astro';
import Statistic from '../components/Statistic.astro';
const [impactEntry, homepageEntry] = await Promise.all([getEntry('impactPage', 'index'), getEntry('homepage', 'index')]);
const impact = impactEntry!.data;
const homepage = homepageEntry!.data;
---
<BaseLayout title="Our impact" description="Explore DOERs work in coastal cleanups, tree planting, sea turtle protection and community care.">
  <PageHeading {...impact.heading} />
  <Section id="programs" title={impact.programsTitle} eyebrow={impact.programsEyebrow}>
    <div class="grid grid--3">{homepage.programs.map(program => <Card title={program.title}><Photo slot="image" src={program.image} alt={program.title} sizes="(min-width: 48rem) 33vw, 100vw" /><p>{program.description}</p></Card>)}</div>
  </Section>
  <Section tone="soft" id="impact-record" title={impact.recordTitle}>
    {impact.metrics.length ? <><dl class="grid grid--3">{impact.metrics.map(metric => <Statistic value={metric.value} label={metric.label} context={`${metric.period} · ${metric.source}`} />)}</dl>{impact.lastUpdated && <p>Updated <time datetime={impact.lastUpdated}>{impact.lastUpdated}</time></p>}</> : <p class="prose">{impact.noMetricsMessage} Explore our <a href="/about#recognition">documented recognitions</a> to learn more about our work.</p>}
  </Section>
</BaseLayout>
