---
// Full first-activity guide and conversion flow follow in Phase 2.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
const [siteEntry, volunteerEntry] = await Promise.all([getEntry('settings', 'index'), getEntry('volunteerPage', 'index')]);
const site = siteEntry!.data;
const volunteer = volunteerEntry!.data;
---
<BaseLayout title="Volunteer with us" image="/images/meta/get-involved.jpg" description="Try volunteering with DOERs. First-timers are welcome, membership is not required, and you can join whenever your schedule allows.">
  <PageHeading {...volunteer.heading} />
  <Section>
    <div class="split">
      <div class="prose">
        <h2>{volunteer.startTitle}</h2>
        {volunteer.startBody.map(paragraph => <p>{paragraph}</p>)}
        <div class="actions"><CTA href={volunteer.activityButtonHref}>{volunteer.activityButtonLabel}</CTA></div>
        <h2>{volunteer.preparationTitle}</h2>
        <p>{volunteer.preparationBody}</p>
        <CTA href={site.facebook} variant="outline">{volunteer.facebookButtonLabel}</CTA>
        <p><a class="text-link" href={site.collaborationForm}>{volunteer.inquiryLabel}</a></p>
        {site.membershipForm && <a class="text-link" href={site.membershipForm}>{volunteer.membershipLabel}</a>}
      </div>
      <Photo src={volunteer.image} alt={volunteer.imageAlt} />
    </div>
  </Section>
</BaseLayout>
