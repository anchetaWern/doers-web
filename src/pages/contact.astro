---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
const [siteEntry, contactPageEntry] = await Promise.all([getEntry('settings', 'index'), getEntry('contactPage', 'index')]);
const site = siteEntry!.data;
const contactPage = contactPageEntry!.data;
---
<BaseLayout title="Contact us" description="Contact DOERs about volunteering, partnerships or community initiatives. Find our Facebook page, Google Form, email and La Union headquarters.">
  <PageHeading {...contactPage.heading} />
  <Section><div class="split"><div class="prose"><h2>{contactPage.contactTitle}</h2><p><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.phoneHref}>{site.phone}</a></p><div class="actions"><CTA href={site.facebook}>{contactPage.facebookButtonLabel}</CTA><CTA href={site.collaborationForm} variant="outline">{contactPage.inquiryButtonLabel}</CTA></div><h3>{contactPage.socialTitle}</h3><ul>{site.socials.filter(s=>s.label!=='Facebook').map(s=><li><a href={s.href}>{s.label} ↗</a></li>)}</ul></div><div class="prose"><h2>{contactPage.locationTitle}</h2><address>DOERs headquarters<br />{site.address}</address><p>{contactPage.visitNote}</p><CTA href={site.mapUrl} variant="outline">{contactPage.mapButtonLabel}</CTA></div></div></Section>
</BaseLayout>
