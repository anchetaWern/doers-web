---
// Phase 1: migrate useful content onto the new foundation. Full homepage in Phase 2.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import CTA from '../components/CTA.astro';
import Photo from '../components/Photo.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
const homepageEntry = await getEntry('homepage', 'index');
const homepage = homepageEntry!.data;
---
<BaseLayout title="DOERs">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{homepage.hero.eyebrow}</p>
        <h1 id="hero-heading">{homepage.hero.headingStart}<br />{homepage.hero.headingEnd}</h1>
        <p>{homepage.hero.description}</p>
        <div class="actions"><CTA href={homepage.hero.primaryHref}>{homepage.hero.primaryLabel}</CTA><CTA href={homepage.hero.secondaryHref} variant="outline">{homepage.hero.secondaryLabel}</CTA></div>
        <p class="hero-note">{homepage.hero.note}</p>
      </div>
      <figure><Photo src={homepage.hero.image} alt={homepage.hero.imageAlt} eager /><figcaption>{homepage.hero.caption}</figcaption></figure>
    </div>
  </section>
  <Section id="who-we-are" title={homepage.introduction.title} eyebrow={homepage.introduction.eyebrow} tone="soft">
    <div class="split">
      <p>{homepage.introduction.description}</p>
      <div><p>{homepage.introduction.chapterNote}</p><a class="text-link" href={homepage.introduction.linkHref}>{homepage.introduction.linkLabel}</a></div>
    </div>
  </Section>
  <Section id="our-work" title="Hands-on care for people and the environment." eyebrow="What we do">
    <div class="grid grid--3">{homepage.programs.map(program => <Card title={program.title}>
      <Photo slot="image" src={program.image} alt={program.title} sizes="(min-width: 48rem) 33vw, 100vw" />
      <p>{program.description}</p>
    </Card>)}</div>
    <div class="actions"><CTA href="/volunteer">Volunteer with us</CTA><a class="text-link" href="/impact">Explore our work →</a></div>
  </Section>
</BaseLayout>
