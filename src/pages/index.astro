---
// Phase 1: migrate useful content onto the new foundation. Full homepage in Phase 2.
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Photo from '../components/Photo.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { programs } from '../data/programs';
---
<BaseLayout title="DOERs">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Dalumpinas Oeste Eco Rangers</p>
        <h1 id="hero-heading">Care for our coasts.<br />Show up for our communities.</h1>
        <p>Join DOERs in protecting the environment and supporting our communities through coastal cleanups, tree planting, turtle conservation and more.</p>
        <div class="actions"><CTA href="/activities">Join an Activity</CTA><CTA href="/partners" variant="outline">Partner with DOERs</CTA></div>
        <p class="hero-note">First-timers welcome. You don’t need to be a member to volunteer.</p>
      </div>
      <figure><Photo src="home/sunrise-cleanup.jpg" alt="DOERs volunteers taking part in a coastal cleanup" eager /><figcaption>Our community, taking care of the coast.</figcaption></figure>
    </div>
  </section>
  <Section id="who-we-are" title="Small acts, shared responsibility." eyebrow="Who we are" tone="soft">
    <div class="split">
      <p>Dalumpinas Oeste Eco Rangers (DOERs) is a nonprofit organization caring for roads and beaches, protecting sea turtle nests and hatchlings, and supporting communities through feeding programs, tree planting, blood drives and medical missions.</p>
      <div><p>Our main chapter is in La Union, with chapters in Ilocos Norte and Bataan.</p><a class="text-link" href="/about">Get to know DOERs →</a></div>
    </div>
  </Section>
  <Section id="our-work" title="Hands-on care for people and the environment." eyebrow="What we do">
    <div class="grid grid--3">{programs.map(program => <Card title={program.title}>
      <Photo slot="image" src={program.image} alt={program.title} sizes="(min-width: 48rem) 33vw, 100vw" />
      <p>{program.description}</p>
    </Card>)}</div>
    <div class="actions"><CTA href="/volunteer">Volunteer with us</CTA><a class="text-link" href="/impact">Explore our work →</a></div>
  </Section>
</BaseLayout>
