---
// Existing collaboration flow and historical partners migrated for the foundation.
// Dedicated partner pathways and active rewards follow in Phase 4.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import Photo from '../components/Photo.astro';
const partners = await getCollection('partners');
const [siteEntry, partnerPageEntry] = await Promise.all([getEntry('settings', 'index'), getEntry('partnerPage', 'index')]);
const site = siteEntry!.data;
const partnerPage = partnerPageEntry!.data;
---
<BaseLayout title="Partner with DOERs" description="Support DOERs environmental and community initiatives. Connect through our existing Google Form to discuss collaboration or in-kind support.">
  <PageHeading {...partnerPage.heading} />
  <Section>
    <div class="split">
      <div class="prose"><h2>{partnerPage.collaborationTitle}</h2><p>{partnerPage.collaborationBody}</p><CTA href={site.collaborationForm}>{partnerPage.formButtonLabel}</CTA><p>{partnerPage.contactLead} <a href="/contact">Contact DOERs</a>.</p></div>
      <Photo src={partnerPage.image} alt={partnerPage.imageAlt} />
    </div>
  </Section>
  <Section id="historical-partners" title={partnerPage.partnersTitle} eyebrow={partnerPage.partnersEyebrow} tone="soft">
    <p slot="intro">{partnerPage.partnersIntro}</p>
    <div class="partner-grid">{partners.map(({ data }) => <figure class="partner">
      {data.logo && <div class="partner-mark"><img src={data.logo} alt="" width="112" height="112" loading="lazy" decoding="async" /></div>}
      <figcaption>{data.name}</figcaption>
    </figure>)}</div>
  </Section>
</BaseLayout>
