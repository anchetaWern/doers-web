---
// Phase 1 migration destination. Collection-driven filtering/cards follow in Phase 3.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
const [siteEntry, activitiesPageEntry] = await Promise.all([getEntry('settings', 'index'), getEntry('activitiesPage', 'index')]);
const site = siteEntry!.data;
const activitiesPage = activitiesPageEntry!.data;
---
<BaseLayout title="Upcoming activities" description="Find DOERs activity announcements and plan your first volunteer experience. Check Facebook for the latest dates and meeting details.">
  <PageHeading {...activitiesPage.heading} />
  <Section>
    <div class="notice prose">
      <h2>{activitiesPage.emptyTitle}</h2>
      <p>{activitiesPage.emptyBody}</p>
      <div class="actions"><CTA href={site.facebookEvents}>{activitiesPage.facebookButtonLabel}</CTA><CTA href="/volunteer" variant="outline">{activitiesPage.volunteerButtonLabel}</CTA></div>
    </div>
  </Section>
</BaseLayout>
