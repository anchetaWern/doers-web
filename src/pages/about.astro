---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
const recognition = (await getCollection('timeline')).sort((a,b) => b.data.date.localeCompare(a.data.date));
const aboutEntry = await getEntry('aboutPage', 'index');
const about = aboutEntry!.data;
const dateLabel = (date: string) => date.length === 4 ? date : new Intl.DateTimeFormat('en-PH', {
  year: 'numeric', month: 'long', day: date.length === 10 ? 'numeric' : undefined, timeZone: 'Asia/Manila',
}).format(new Date(`${date.length === 7 ? `${date}-01` : date}T00:00:00+08:00`));
---
<BaseLayout title="About us" image="/images/meta/about-us.jpg" description="Learn about Dalumpinas Oeste Eco Rangers, our environmental and community work, our founding team and documented recognitions.">
  <PageHeading {...about.heading} />
  <Section id="organization" title={about.organizationTitle} eyebrow={about.organizationEyebrow}>
    <div class="about-grid">
      <div class="prose"><h3>{about.organizationTitle}</h3><dl class="letter-list">{about.principles.map(item => <div><dt>{item.letter}</dt><dd>{item.text}</dd></div>)}</dl></div>
      <Photo src={about.organizationImage} alt={about.organizationImageAlt} />
    </div>
  </Section>
  <Section id="vision-mission" title={about.visionMissionTitle} eyebrow={about.visionMissionEyebrow} tone="soft">
    <div class="grid grid--2"><article class="prose"><h3>Vision</h3><p>{about.vision}</p></article><article class="prose"><h3>Mission</h3><p>{about.mission}</p></article></div>
  </Section>
  <Section id="core-values" title={about.valuesTitle} eyebrow={about.valuesEyebrow}>
    <dl class="letter-list letter-list--values">{about.values.map(item => <div><dt>{item.letter}</dt><dd>{item.text}</dd></div>)}</dl>
  </Section>
  <Section id="founding" title={about.foundingTitle} eyebrow={about.foundingEyebrow} tone="soft"><div class="prose"><p>{about.foundingLead} {about.founders.map(f => `${f.name} (${f.role})`).join(' and ')}.</p><a class="text-link" href="/chapters">{about.chaptersLinkLabel}</a></div></Section>
  <Section id="recognition" title={about.recognitionTitle} eyebrow={about.recognitionEyebrow}>
    <p slot="intro">{about.recognitionIntro}</p>
    {recognition.map(({ data }) => <details class="recognition"><summary><time datetime={data.date}>{dateLabel(data.date)}</time>{data.title}</summary><p>{data.description}</p>{data.facebookUrl && <a class="text-link" href={data.facebookUrl}>Read the original Facebook post ↗</a>}<div class="recognition-images">{data.images.map(src => <Photo src={src} alt={`${data.title} — recognition record`} sizes="(min-width: 48rem) 50vw, 100vw" />)}</div></details>)}
    <div class="actions"><CTA href="/partners">Partner with DOERs</CTA><CTA href="/volunteer" variant="outline">Try volunteering</CTA></div>
  </Section>
</BaseLayout>
