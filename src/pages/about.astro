---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
import { organization } from '../data/organization';
const recognition = (await getCollection('timeline')).sort((a,b) => b.data.date.localeCompare(a.data.date));
const dateLabel = (date: string) => date.length === 4 ? date : new Intl.DateTimeFormat('en-PH', {
  year: 'numeric', month: 'long', day: date.length === 10 ? 'numeric' : undefined, timeZone: 'Asia/Manila',
}).format(new Date(`${date.length === 7 ? `${date}-01` : date}T00:00:00+08:00`));
---
<BaseLayout title="About us" image="/images/meta/about-us.jpg" description="Learn about Dalumpinas Oeste Eco Rangers, our environmental and community work, our founding team and documented recognitions.">
  <PageHeading title="Who we are" eyebrow="About DOERs" description={organization.whoWeAre} />
  <Section id="organization" title="DOERS" eyebrow="Our organization">
    <div class="about-grid">
      <div class="prose"><h3>DOERS</h3><dl class="letter-list">{organization.principles.map(item => <div><dt>{item.letter}</dt><dd>{item.text}</dd></div>)}</dl></div>
      <Photo src="home/sunset-plogging.jpg" alt="DOERs taking part in a coastal community activity" />
    </div>
  </Section>
  <Section id="vision-mission" title="Vision and Mission" eyebrow="Our direction" tone="soft">
    <div class="grid grid--2"><article class="prose"><h3>Vision</h3><p>{organization.vision}</p></article><article class="prose"><h3>Mission</h3><p>{organization.mission}</p></article></div>
  </Section>
  <Section id="core-values" title="Core Values" eyebrow="EARTH">
    <dl class="letter-list letter-list--values">{organization.values.map(item => <div><dt>{item.letter}</dt><dd>{item.text}</dd></div>)}</dl>
  </Section>
  <Section id="founding" title="Built by volunteers." eyebrow="Our beginnings" tone="soft"><div class="prose"><p>Our founding team includes {organization.founders.map(f => `${f.name} (${f.role})`).join(' and ')}.</p><a class="text-link" href="/chapters">Meet our chapters →</a></div></Section>
  <Section id="recognition" title="Recognition of a shared effort." eyebrow="Awards & features">
    <p slot="intro">Selected milestones from our existing organizational record. Each recognition reflects the work of volunteers and partners.</p>
    {recognition.map(({ data }) => <details class="recognition"><summary><time datetime={data.date}>{dateLabel(data.date)}</time>{data.title}</summary><p>{data.description}</p>{data.facebookUrl && <a class="text-link" href={data.facebookUrl}>Read the original Facebook post ↗</a>}<div class="recognition-images">{data.images.map(src => <Photo src={src} alt={`${data.title} — recognition record`} sizes="(min-width: 48rem) 50vw, 100vw" />)}</div></details>)}
    <div class="actions"><CTA href="/partners">Partner with DOERs</CTA><CTA href="/volunteer" variant="outline">Try volunteering</CTA></div>
  </Section>
</BaseLayout>
