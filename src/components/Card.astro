---
interface Props { title: string; href?: string; class?: string; }
const { title, href, class: className } = Astro.props;
---
<article class:list={['card', className]}>
  <slot name="image" />
  <div class="card-body">
    <h3>{href ? <a href={href}>{title}<span aria-hidden="true"> →</span></a> : title}</h3>
    <slot />
  </div>
</article>
