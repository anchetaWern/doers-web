---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { src, alt, eager = false, class: className, sizes = '(min-width: 70rem) 560px, (min-width: 48rem) 50vw, 100vw' } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,png,webp}');
const loader = photos[`/src/assets/images/${src}`];
if (!loader) throw new Error(`Unknown photo: ${src}. Add it under src/assets/images/.`);
const { default: photo } = await loader();
const maxWidth = Math.min(photo.width, 1440);
const widths = [...new Set([360, 640, 960, maxWidth].filter(width => width <= maxWidth))];
---
<Image src={photo} alt={alt} width={maxWidth} widths={widths} sizes={sizes}
  format="webp" quality={80} loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'} decoding="async" class:list={['photo', className]} />
